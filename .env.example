# قاعدة البيانات (Neon / Supabase) – انسخ الرابط من لوحة Neon
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# مفتاح سري طويل وعشوائي لتوقيع جلسات الدخول
AUTH_SECRET=change-me-to-a-long-random-string
# مفتاح سري لتشفير أكواد كروت الشحن (لا تغيّره بعد إنشاء كروت)
CARD_SECRET=change-me-to-another-long-random-string
# true = إنشاء الحسابات التجريبية تلقائياً عند أول تشغيل ، false = بدون بيانات تجريبية
SEED_DEMO=true
